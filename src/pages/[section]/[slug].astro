---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedEntries, sectionFor, period, absoluteDate, localHref, type Entry } from '../../lib/content';
import site from '../../data/site.json';
export async function getStaticPaths() {
  return (await publishedEntries()).filter(e=>sectionFor(e).detail && !e.data.externalUrl).map(entry=>({params:{section:sectionFor(entry).route,slug:entry.data.slug},props:{entry}}));
}
interface Props { entry: Entry; }
const { entry } = Astro.props;
const { data } = entry;
const section = sectionFor(entry);
const { Content } = await render(entry);
const canonical = new URL(localHref(entry),site.siteUrl).href;
const schemaType = section.kind === 'article' ? 'BlogPosting' : section.kind === 'project' && data.github ? 'SoftwareSourceCode' : 'CreativeWork';
const schema = {
  '@type':schemaType, '@id':`${canonical}#work`, url:canonical, name:data.title, ...(schemaType === 'BlogPosting' ? {headline:data.title} : {}), description:data.description,
  author:{'@id':`${site.siteUrl}/#person`}, inLanguage:'tr-TR',
  datePublished:absoluteDate(data.date), dateModified:absoluteDate(data.updated),
  ...(data.github && schemaType === 'SoftwareSourceCode' ? {codeRepository:data.github} : {}),
  ...(data.image ? {image:new URL(data.image.src,site.siteUrl).href} : {}),
  keywords:[...data.tags,...data.technologies].join(', '), mainEntityOfPage:{'@id':`${canonical}#webpage`}
};
---
<BaseLayout title={data.title} description={data.description} article={section.kind === 'article'} image={data.image?.src} imageAlt={data.imageAlt} schema={schema}>
  <article class="detail-page">
    <header class="page-intro detail-intro">
      <a class="back-link" href={`/${section.route}/`}>← {section.title}</a>
      <div class="entry-meta"><span>{section.singular}</span>{period(entry) && <span>{period(entry)}</span>}{data.status && <span>{data.status}</span>}</div>
      <h1>{data.title}</h1>
      {data.subtitle && <p class="detail-subtitle">{data.subtitle}</p>}
      <p class="page-description">{data.description}</p>
      {!!data.technologies.length && <ul class="tag-list" aria-label="Kullanılan teknolojiler">{data.technologies.map(t=><li>{t}</li>)}</ul>}
      {(data.github || data.website) && <div class="links">{data.github && <a href={data.github}>GitHub kaynak kodu <span aria-hidden="true">↗</span></a>}{data.website && <a href={data.website}>Proje sitesi <span aria-hidden="true">↗</span></a>}</div>}
    </header>
    {data.image && <figure class="detail-cover"><Image src={data.image} alt={data.imageAlt || ''} widths={[480,768,1200,1600]} sizes="(max-width: 1120px) 100vw, 1120px" format="webp" loading="eager" decoding="async"/></figure>}
    <div class="article-layout">
      <aside class="article-aside"><p class="aside-label">{section.singular}</p><p>{site.name}</p>{!!data.tags.length && <ul class="article-tags">{data.tags.map(t=><li>{t}</li>)}</ul>}{data.extra && <dl>{Object.entries(data.extra).map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}</aside>
      <div class="prose article-prose"><Content /></div>
    </div>
    <footer class="article-end"><a href={`/${section.route}/`}>← Tüm {section.title.toLocaleLowerCase('tr-TR')}</a></footer>
  </article>
</BaseLayout>
